# Copiar como .env y completar con tus credenciales reales
PORT=3000

# Mercado Pago — Access Token de PRODUCCIÓN
MP_ACCESS_TOKEN=APP_USR-tu-access-token-de-produccion

# Firebase Admin SDK — Descargar serviceAccountKey.json desde Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Secret para validar firma del webhook (opcional pero recomendado)
MP_WEBHOOK_SECRET=tu-secret-para-validar
